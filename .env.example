# Set strong unique secrets before starting the stack.
POSTGRES_PASSWORD=
SON_JWT_SECRET=
SON_INGESTION_API_TOKEN=

# Live network changes remain disabled unless vendor profiles and device
# allowlists are deliberately configured and validated on a lab network.
SON_NETCONF_ENABLED=false
SON_NETCONF_USERNAME=
SON_NETCONF_PASSWORD=
SON_NETCONF_KNOWN_HOSTS=/run/son/known_hosts
SON_ALLOWED_DEVICE_CIDRS=
SON_NETCONF_ACTION_TEMPLATES_JSON=
NETCONF_KNOWN_HOSTS_FILE=./known_hosts.example
